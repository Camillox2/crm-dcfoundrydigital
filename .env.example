# ==============================================================================
# DC Foundry Digital CRM — Variáveis de Ambiente (NUNCA versionar segredos reais)
# ==============================================================================

NODE_ENV=production
PORT=4000
WEB_URL=https://crm.example.com
API_URL=https://crm.example.com

# --- Banco de Dados (Produção: Neon Postgres | Dev/Fallback: Docker Local) ---
DATABASE_URL=postgresql://dcfoundry:SET_DATABASE_PASSWORD@postgres:5432/dcfoundry_crm
DATABASE_FALLBACK_URL=

# --- Redis (BullMQ / Filas / Rate Limit / Sessões) ---
REDIS_URL=redis://redis:6379

# --- Autenticação, Sessão e Criptografia em Repouso (LGPD Art. 11 & Baileys) ---
# Gere com: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_32_byte_hex_access_secret_minimum_64_chars_000000
JWT_REFRESH_SECRET=replace_with_32_byte_hex_refresh_secret_minimum_64_chars_000000
ENCRYPTION_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Foundry: modelos de texto descobertos na API; lista opcional de fallback ---
GEMINI_API_KEY=
GEMINI_MODELS=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Google Ads & GA4 Attribution (Nunca hardcode no código) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_QUALIFIED_LEAD_CONVERSION_ACTION_ID=
GOOGLE_ADS_CLOSED_CONTRACT_CONVERSION_ACTION_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
CLARITY_PROJECT_ID=

# --- Pagamentos (Mercado Pago Pix / Boleto) ---
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@dcfoundrydigital.com

# --- First administrator: configure only on your VPS, run pnpm db:admin, then remove the password ---
CRM_ADMIN_EMAIL=
CRM_ADMIN_NAME=
CRM_ADMIN_PASSWORD=
CRM_DOMAIN=localhost

POSTGRES_USER=dcfoundry
POSTGRES_DB=dcfoundry_crm
POSTGRES_PASSWORD=

# --- Blog: feed público no CRM e webhook do site; use o mesmo segredo nos dois ---
CRM_SITE_URL=https://dcfoundrydigital.com
BLOG_SITE_WEBHOOK_URL=https://dcfoundrydigital.com/api/blog/revalidate
BLOG_REVALIDATE_SECRET=
CRM_UPLOAD_DIR=/data/uploads
CRM_DB_POOL_SIZE=10

# --- Recebimento do Google Ads: gere um token com pelo menos 32 caracteres ---
CRM_ADS_INGEST_TOKEN=
