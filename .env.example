# ==============================================================================
# DC Foundry Digital CRM — Variáveis de Ambiente (NUNCA versionar segredos reais)
# ==============================================================================

NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000

# --- Banco de Dados (Produção: Neon Postgres | Dev/Fallback: Docker Local) ---
DATABASE_URL=postgresql://dcfoundry:dcfoundry_local_dev@localhost:5432/dcfoundry_crm
DATABASE_FALLBACK_URL=postgresql://dcfoundry:dcfoundry_local_dev@localhost:5432/dcfoundry_crm

# --- Redis (BullMQ / Filas / Rate Limit / Sessões) ---
REDIS_URL=redis://localhost:6379

# --- Autenticação, Sessão e Criptografia em Repouso (LGPD Art. 11 & Baileys) ---
# Gere com: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_32_byte_hex_access_secret_minimum_64_chars_000000
JWT_REFRESH_SECRET=replace_with_32_byte_hex_refresh_secret_minimum_64_chars_000000
ENCRYPTION_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Inteligência Artificial (Gemini Primary + Ollama Local Fallback) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Google Ads & GA4 Attribution (Nunca hardcode no código) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_QUALIFIED_LEAD_CONVERSION_ACTION_ID=
GOOGLE_ADS_CLOSED_CONTRACT_CONVERSION_ACTION_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
CLARITY_PROJECT_ID=

# --- Pagamentos (Mercado Pago Pix / Boleto) ---
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@dcfoundrydigital.com
